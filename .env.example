# Secret key for the playit.gg agent, from https://playit.gg dashboard. REQUIRED.
PLAYIT_SECRET_KEY=

# CurseForge API key. OPTIONAL — the server image bundles a working key for
# the in-container modpack install, so this isn't needed for that.
# Set this (free key from console.curseforge.com) to let
# scripts/resolve-java-tag.sh resolve the required Java version up front, via
# the CurseForge API, before any deploy. Without it, that script falls back
# to deploying once and polling the pod for the same info — works fine, just
# costs one extra deploy cycle whenever the modpack's Minecraft version changes.
# CF_API_KEY=